{
	"name": "matt-and-adria",
	"displayName": "Matt and Adria",
	"description": "Wedding website for Matt and Adria.",
	"version": "1.1.0",
	"main": "bundle.js",
	"type": "module",
	"keywords": [],
	"author": "displaycoffee",
	"license": "ISC",
	"homepage": "https://mattandadria.com",
	"scripts": {
		"generate:dev": "node scripts/src-generate.js && npx prettier --write src/index.html",
		"generate:dist": "node scripts/dist-generate.js && npx prettier --write dist/index.html --ignore-path /dev/null",
		"generate:public": "node scripts/public-generate.js && npx prettier --write public/manifest.json",
		"generate:thumbnails": "node scripts/thumbnails-generate.js",
		"generate:thumbnails:clean": "node scripts/thumbnails-generate.js --clean",
		"build": "npm run generate:thumbnails && vite build && npm run generate:dist && npm run generate:public",
		"dev": "npm run generate:public && npm run generate:dev && vite --host",
		"format": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
		"lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --quiet",
		"preview": "vite preview"
	},
	"devDependencies": {
		"@tanstack/react-query-devtools": "^5.102.8",
		"@tanstack/router-devtools": "^1.167.2",
		"@tanstack/router-plugin": "^1.168.38",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@typescript-eslint/eslint-plugin": "8.70.0",
		"@typescript-eslint/parser": "^8.70.0",
		"@vitejs/plugin-basic-ssl": "^2.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "17.12.0",
		"prettier": "^3.9.6",
		"sass": "^1.104.1",
		"sharp": "^0.35.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.3.0",
		"vite-plugin-sitemap": "^0.8.2"
	},
	"dependencies": {
		"@tanstack/react-router": "^1.170.36",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/displaycoffee/matt-and-adria.git"
	},
	"bugs": {
		"url": "https://github.com/displaycoffee/matt-and-adria/issues"
	},
	"browserslist": [
		"last 2 versions"
	]
}
